# окружение
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
.ipynb_checkpoints/

# логгеры
wandb/
.hydra/
outputs/

# скачанные данные и внешний код
datasets/*
ext/*
!datasets/.gitkeep
!datasets/*.json
!datasets/*.jsonl
!ext/.gitkeep

# тяжёлые веса; код, логи, tmp, HTML и рисунки остаются в git
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# секреты
.env
*.key

# mlflow (локальный трекинг)
mlflow.db
mlruns/
mlartifacts/

# logs/, runs/ и tmp/ содержат доказательства и отслеживаются

# служебные инструкции агентов
AGENTS.md
CLAUDE.md

# сырые дампы screening: screening.html self-contained, агрегаты вшиты внутрь
runs/**/screening.json
runs/**/*.pkl

# автоматизация и wiring-проверки: проверяющим не нужны
tmp/
